# ─────────────────────────────────────────────────────────────────────────────
# Browser (VITE_*) — these are bundled into the client and are public.
# ─────────────────────────────────────────────────────────────────────────────

# Shows the Stripe checkout button instead of the manual order form.
# Leave unset or 'false' until the /api endpoints are deployed and tested.
VITE_CHECKOUT_ENABLED=false

# Loops, for the waitlist form.
VITE_LOOPS_API_KEY=


# ─────────────────────────────────────────────────────────────────────────────
# Server — set these in the Vercel project, never in the repo.
# They are read by the functions in /api and are never sent to the browser.
# ─────────────────────────────────────────────────────────────────────────────

# Secret key from https://dashboard.stripe.com/apikeys (sk_test_… or sk_live_…)
STRIPE_SECRET_KEY=

# Signing secret for the webhook endpoint, from
# https://dashboard.stripe.com/webhooks after adding /api/webhook (whsec_…)
STRIPE_WEBHOOK_SECRET=

# The six price IDs, from https://dashboard.stripe.com/products
# Three products (1 / 2 / 3 boxes), each with a one-time and a monthly price.
# Open a price and copy the id beginning price_…
STRIPE_PRICE_BOX1_ONCE=
STRIPE_PRICE_BOX2_ONCE=
STRIPE_PRICE_BOX3_ONCE=
STRIPE_PRICE_BOX1_SUB=
STRIPE_PRICE_BOX2_SUB=
STRIPE_PRICE_BOX3_SUB=

# Shipping rates, from Dashboard > Products > Leveranspriser (shr_…)
# STANDARD is charged on one-time orders below the free-shipping threshold.
# FREE should be a 0 kr rate; it is used for subscriptions and for orders at
# or above the threshold. Leaving both empty collects an address and charges
# no shipping.
STRIPE_SHIPPING_RATE_STANDARD=
STRIPE_SHIPPING_RATE_FREE=

# Boxes required for free shipping on a one-time order. Defaults to 3.
# Set to 2 once carrier quotes confirm it is affordable.
FREE_SHIPPING_FROM_BOXES=3

# Let Stripe Tax calculate moms. Leave unset: prices are already moms-inclusive
# at 12% and the shop sells only in Sweden, so this would add 0.5% per
# transaction for nothing. Turn on when selling into Denmark and Norway.
STRIPE_AUTOMATIC_TAX=false

# Overrides the origin used for success and cancel URLs. Normally detected
# from the request, so only needed behind an unusual proxy.
SITE_ORIGIN=
